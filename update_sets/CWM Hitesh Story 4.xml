<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script"&gt;&lt;sys_script action="INSERT_OR_UPDATE"&gt;&lt;abort_action&gt;false&lt;/abort_action&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;action_delete&gt;false&lt;/action_delete&gt;&lt;action_insert&gt;false&lt;/action_insert&gt;&lt;action_query&gt;false&lt;/action_query&gt;&lt;action_update&gt;true&lt;/action_update&gt;&lt;active&gt;true&lt;/active&gt;&lt;add_message&gt;false&lt;/add_message&gt;&lt;advanced&gt;true&lt;/advanced&gt;&lt;change_fields&gt;false&lt;/change_fields&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;collection&gt;sn_cwm_task&lt;/collection&gt;&lt;condition/&gt;&lt;description/&gt;&lt;execute_function&gt;false&lt;/execute_function&gt;&lt;filter_condition table="sn_cwm_task"&gt;state=3^EQ&lt;item display_value="Closed Complete" endquery="false" field="state" goto="false" newquery="false" operator="=" or="false" value="3"/&gt;&lt;item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/&gt;&lt;/filter_condition&gt;&lt;is_rest&gt;false&lt;/is_rest&gt;&lt;message/&gt;&lt;name&gt;CWM Complete Story - Complete Update Set&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;priority&gt;100&lt;/priority&gt;&lt;rest_method/&gt;&lt;rest_method_text/&gt;&lt;rest_service/&gt;&lt;rest_service_text/&gt;&lt;rest_variables/&gt;&lt;role_conditions/&gt;&lt;script&gt;&lt;![CDATA[(function executeRule(current, previous /* null when async */) {

    gs.info(
        'CWM Story Automation: Story completed: ' +
        current.getDisplayValue()
    );

    // -----------------------------------------
    // Make sure Story actually changed to
    // Closed Complete
    // -----------------------------------------

    if (!current.state.changesTo('3')) {

        gs.info(
            'CWM Story Automation: State did not change to Closed Complete. Skipping.'
        );

        return;
    }


    // -----------------------------------------
    // Get linked Update Set
    // -----------------------------------------

    if (current.u_update_set.nil()) {

        gs.error(
            'CWM Story Automation: No Update Set linked to CWM Task: ' +
            current.getDisplayValue()
        );

        return;
    }


    var updateSetId =
        current.getValue('u_update_set');


    var updateSet =
        new GlideRecord('sys_update_set');


    if (!updateSet.get(updateSetId)) {

        gs.error(
            'CWM Story Automation: Linked Update Set not found: ' +
            updateSetId
        );

        return;
    }


    gs.info(
        'CWM Story Automation: Linked Update Set = ' +
        updateSet.getDisplayValue()
    );


    // -----------------------------------------
    // Complete the Update Set
    // -----------------------------------------

    if (updateSet.getValue('state') == 'complete') {

        gs.info(
            'CWM Story Automation: Update Set already Complete. Nothing to do.'
        );

        return;
    }


    updateSet.setValue(
        'state',
        'complete'
    );

    updateSet.update();


    gs.info(
        'CWM Story Automation: Update Set marked Complete: ' +
        updateSet.getDisplayValue()
    );

})(current, previous);]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-10-06 17:42:07&lt;/sys_created_on&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path&gt;/&lt;/sys_domain_path&gt;&lt;sys_id&gt;266b970dc3b707143d5ef61d050131c2&lt;/sys_id&gt;&lt;sys_mod_count&gt;1&lt;/sys_mod_count&gt;&lt;sys_name&gt;CWM Complete Story - Complete Update Set&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Global" source="global"&gt;global&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Global"&gt;global&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_266b970dc3b707143d5ef61d050131c2&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-10-06 17:44:22&lt;/sys_updated_on&gt;&lt;template/&gt;&lt;when&gt;after&lt;/when&gt;&lt;/sys_script&gt;&lt;sys_translated_text action="delete_multiple" query="documentkey=266b970dc3b707143d5ef61d050131c2"/&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;266b970dc3b707143d5ef61d050131c2&lt;/id&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-10-06 17:42:06&lt;/sys_created_on&gt;&lt;sys_id&gt;b4db538dc3b707143d5ef61d050131c5&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-10-06 17:42:06&lt;/sys_updated_on&gt;&lt;table&gt;sys_script&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
